# Copy to .env and fill in real values. Never commit the real .env file.

# MongoDB Atlas connection string
MONGODB_URI=

# OpenAI — used for Whisper transcription and (if Pinecone is configured)
# embeddings for RAG recall/morning report/search
OPENAI_API_KEY=

# Google Gemini — primary model for issue detection, recall summaries,
# shift handovers, and morning reports
GEMINI_API_KEY=

# OpenRouter — free-model fallback used when Gemini is unavailable/unset
OPENROUTER_API_KEY=

# Local dev server port
PORT=5001

# Secret used to sign JWTs — use a long random value in production
JWT_SECRET=

# AWS S3 (tenant file storage — Vault media uploads, Business DNA documents)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Pinecone (M3B — vector search for RAG recall/morning report/search).
# Optional: the system falls back to MongoDB text search automatically
# when PINECONE_API_KEY is unset.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=opsfly-memory
PINECONE_ENVIRONMENT=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
